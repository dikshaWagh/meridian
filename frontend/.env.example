# live | simulation
# live: Dashboard and Playground poll the real Meridian backend through the Vite proxy.
# simulation: everything is generated in the browser and labelled Simulated.
VITE_MODE=live

# Upstream Meridian server used by the Vite dev proxy (Vite config only).
VITE_MERIDIAN_URL=http://localhost:8080

# Optional. Leave empty to use same-origin requests (recommended with the dev proxy).
# Set only when a reverse proxy in front of the built app forwards /status and /v1.
# Direct cross-origin calls will fail because Meridian sends no CORS headers.
VITE_API_BASE=
